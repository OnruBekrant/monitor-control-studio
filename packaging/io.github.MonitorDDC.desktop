[Desktop Entry]
Type=Application
Name=Monitör Kontrol Stüdyosu
GenericName=DDC/CI Monitor Control
Comment=Harici monitörün renk, parlaklık ve ses ayarlarını donanımsal olarak yönet
Exec=@BIN@
Icon=preferences-desktop-display-color
